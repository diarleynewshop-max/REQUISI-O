{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": [
        "../*.csv",
        "../*.json",
        "../*.xlsx",
        "../*.txt",
        "../server.js",
        "../package.json",
        "../node_modules/**"
      ]
    }
  }
}
