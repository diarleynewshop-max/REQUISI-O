{
  "manifest_version": 3,
  "name": "Auto Lançador NF - Newshop",
  "version": "2.0",
  "description": "Lança automaticamente itens em Notas Fiscais no VarejoFácil a partir de uma lista Codigo;QTD;Valor",
  "permissions": [
    "activeTab",
    "scripting",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://*.varejofacil.com/*",
    "http://*.varejofacil.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.varejofacil.com/*", "http://*.varejofacil.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon.png"
  }
}
